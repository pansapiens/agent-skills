   ;***************************************************************
   ;
   ;  batari Basic Sound Effects Library browser
   ;
   ;  All 117 sound effects from RevEng's Sound Effects Collection,
   ;  ported to bB data format by Karl G (data from
   ;  randomterrain.com/rt-bb-sound-effects.html).
   ;
   ;  Joystick right/left selects effect 0-116 (shown on score).
   ;  Fire button plays it. Data format per frame: AUDV, AUDC, AUDF,
   ;  duration-in-frames; 255 ends the effect.
   ;
   ;  To USE an effect in your own game: copy its data block (the
   ;  lines after the matching "; sN" comment below) into your .bas
   ;  as an sdata stream and play it with the same 4-byte reader
   ;  loop used here (see references/sound-effects-library.md).
   ;
   ;***************************************************************

   set romsize 32k
   set smartbranching on

   dim _Sel = a
   dim _Dur = b
   dim _R = c

   scorecolor = $1E
   COLUBK = $00

mainloop
   drawscreen
   if joy0fire then goto __Play
   if !joy0right && !joy0left then _R = 0 : goto mainloop
   if _R = 1 then goto mainloop
   _R = 1
   if joy0right then goto __Right
   _Sel = _Sel - 1
   if _Sel > 116 then _Sel = 116
__Right
   _Sel = _Sel + 1
   if _Sel > 116 then _Sel = 0

__Show
   score = 0
   temp6 = _Sel
__Show100
   if temp6 < 100 then goto __Show10
   temp6 = temp6 - 100
   score = score + 100
   goto __Show100
__Show10
   if temp6 < 10 then goto __Show1
   temp6 = temp6 - 10
   score = score + 10
   goto __Show10
__Show1
   if temp6 = 0 then goto mainloop
   temp6 = temp6 - 1
   score = score + 1
   goto __Show1

__Play
   scorecolor = $46
   temp5 = 0
   temp6 = _Sel
__FindBank
   if temp6 < 17 then goto __Dispatch
   temp6 = temp6 - 17
   temp5 = temp5 + 1
   goto __FindBank
__Dispatch
   if temp5 = 0 then goto __PB2
   if temp5 = 1 then goto __PB3
   if temp5 = 2 then goto __PB4
   if temp5 = 3 then goto __PB5
   if temp5 = 4 then goto __PB6
   if temp5 = 5 then goto __PB7
   goto __PB8
__PB2
   goto __play2 bank2
__PB3
   goto __play3 bank3
__PB4
   goto __play4 bank4
__PB5
   goto __play5 bank5
__PB6
   goto __play6 bank6
__PB7
   goto __play7 bank7
__PB8
